# The store runs with this file absent and every value below empty.
# Each payment rail switches on independently once its own variables are set.

# Wallet connection (Reown / WalletConnect Cloud project ID)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# JSON-RPC endpoints
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=https://mainnet.hashio.io/api
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# Rail: Hedera — native settlement signed by an operator account
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Merchant account that receives the USDC. Defaults to the operator — but a transfer from an
# account to itself is rejected up front, so if you only have one testnet account and intend
# to pay *from* the operator, this must be set to some other USDC-associated account.
HEDERA_RECIPIENT_ID=
# testnet (default) | mainnet. mainnet switches USDC to 0.0.456858, disables the
# test-buyer faucet, and requires MPP_SECRET_KEY.
HEDERA_NETWORK=
# The HTS token to settle in. Blank uses Circle's testnet USDC, 0.0.429274, which
# faucet.circle.com dispenses. Set 0.0.5449 to use the other testnet USDC instead: no
# faucet, but deep SaucerSwap liquidity if you need more than Circle's rate limit allows.
HEDERA_USDC_TOKEN_ID=

# Rail: Card — Stripe
# sk_test_ keys run in test mode; an sk_live_ key goes live and requires MPP_SECRET_KEY.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Your Stripe profile id (profile_test_... in a sandbox). Create the profile once at
# dashboard.stripe.com/profiles, then read the id back from
#   GET https://api.stripe.com/v2/network/business_profiles/me
# with `Stripe-Version: 2026-07-29.preview`. All three must be set or the card rail stays
# in demo mode — see "Where STRIPE_NETWORK_ID comes from" in the README.
STRIPE_NETWORK_ID=

# Rail: x402 — facilitator endpoint
AX402_FACILITATOR_URL=

# Signs MPP challenges. Optional in demo; required (32+ bytes) on mainnet or with a live
# Stripe key — generate with `openssl rand -base64 32`.
MPP_SECRET_KEY=
